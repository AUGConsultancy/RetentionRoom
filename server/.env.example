PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/retention-room

# Allowed frontend origin (CORS)
CLIENT_URL=http://localhost:5173

# Nodemailer (SMTP — e.g. Gmail app password, SendGrid, Resend SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-inbox@gmail.com
SMTP_PASS=your-app-password

# Where lead notifications go
ADMIN_EMAIL=team@retentionroom.com
